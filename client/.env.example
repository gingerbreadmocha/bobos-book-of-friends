# Locally, this points the Vite dev/preview proxy at your API server and is
# baked into the client so /api requests leave the browser headed to the server.
# On Netlify, set VITE_API_PROXY_TARGET (or the historical API_PROXY_TARGET) in
# the build environment to your production API URL, e.g. https://api.example.com
VITE_API_PROXY_TARGET=http://localhost:3000